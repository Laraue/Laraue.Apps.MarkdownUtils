{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MarkdownTranslatorOptions": {
    "Model": "deepseek-v4-flash",
    "Thinking": false
  },
  "OpenAiClientOptions": {
    "Token": "",
    "BaseUrl": "https://api.deepseek.com"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Translate": {
      "Windows": [
        { "PermitLimit": 3, "Window": "00:01:00" },
        { "PermitLimit": 15, "Window": "00:10:00" },
        { "PermitLimit": 30, "Window": "01:00:00" },
        { "PermitLimit": 50, "Window": "1.00:00:00" }
      ],
      "ConcurrencyLimit": 4
    },
    "DefaultRetryAfter": "00:00:05"
  }
}
